{
  "name": "gifmate-panel",
  "displayName": "gifmate: GIF panel",
  "description": "A GIPHY panel beside your coding agent: search as you type, click a GIF and it is attached to the Codex chat.",
  "version": "0.1.5",
  "publisher": "antonio-arcodia",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/AntonioNoOne/gifmate" },
  "engines": { "vscode": "^1.85.0" },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "gifmate", "title": "GIF", "icon": "media/gif.svg" }]
    },
    "views": {
      "gifmate": [{ "type": "webview", "id": "gifmate.picker", "name": "GIF" }]
    },
    "commands": [{ "command": "gifmate.open", "title": "gifmate: Open the GIF panel" }]
  },
  "scripts": {
    "build": "esbuild src/extension.mjs --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && npx -y @vscode/vsce@3 package --no-dependencies --allow-missing-repository"
  }
}
