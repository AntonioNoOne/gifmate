{
  "name": "gifmate",
  "version": "0.1.0",
  "description": "Watch animated GIFs frame by frame and send GIFs in the chat, from GIPHY.",
  "license": "MIT",
  "mcpServers": {
    "gifmate": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/src/server.mjs"
      ],
      "env": {
        "GIPHY_API_KEY": "${GIPHY_API_KEY}"
      }
    }
  },
  "author": {
    "name": "Antonio Arcodia"
  },
  "types": "./types/index.d.ts"
}
